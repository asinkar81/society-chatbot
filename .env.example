ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# Set to "true" to skip the login page (dev/demo use)
BYPASS_LOGIN=false

# Model tier: "true" = free models (openrouter/free), "false" = paid Claude models
USE_FREE_MODELS=true

# LLM Provider Selection
# Options: "anthropic" or "openrouter"
# Default: "anthropic"
LLM_PROVIDER=anthropic

# === Option 1: Using Direct Anthropic API ===
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === Option 2: Using OpenRouter API ===
# Get your API key from: https://openrouter.ai/
# Free models configured — update if you switch to paid models
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter optional settings (for analytics)
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_SITE_NAME=Society Chatbot

# Data Provider
# Options: "local" or "google"
DATA_PROVIDER=local
